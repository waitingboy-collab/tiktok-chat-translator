# Everything here is optional — the translator works without changing anything.

# Port of the local page (http://localhost:3030)
PORT=3030

# 127.0.0.1 = only this computer can open the page (recommended).
# Set 0.0.0.0 to open it from a phone/tablet on the same Wi-Fi (http://<this-mac-ip>:3030),
# or when hosting it online.
HOST=127.0.0.1

# Optional Euler Stream key (https://www.eulerstream.com) — raises the free connection limits.
SIGN_API_KEY=
